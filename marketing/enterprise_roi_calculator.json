    "sliderInputs": {
      "developerCount": {
        "label": "Number of Full-Time Software Engineers (FTE)",
        "min": 10,
        "max": 5000,
        "step": 10,
        "defaultValue": 250,
        "unit": "Engineers"
      },
      "fullyBurdenedHourlyRateUsd": {
        "label": "Blended Fully Burdened Developer Hourly Cost",
        "min": 50.0,
        "max": 250.0,
        "step": 5.0,
        "defaultValue": 118.18,
        "unit": "USD/Hour"
      },
      "dailyQueriesPerEngineer": {
        "label": "AI Refactoring / Code Intelligence Queries per Day",
        "min": 10,
        "max": 100,
        "step": 5,
        "defaultValue": 40,
        "unit": "Queries/Day"
      },
      "rawTokensPerQuery": {
        "label": "Average Raw Input Context Tokens per Query (Uncompressed)",
        "min": 15000,
        "max": 100000,
        "step": 5000,
        "defaultValue": 48290,
        "unit": "Tokens"
      },
      "blendedInputTokenPricePerMillion": {
        "label": "Blended Frontier LLM Input Token Price",
        "min": 1.0,
        "max": 15.0,
        "step": 0.5,
        "defaultValue": 3.0,
        "unit": "USD / Million Tokens"
      },
      "dailyMinutesSavedPerEngineer": {
        "label": "Daily Developer Minutes Recovered via Sub-110ms Voice & Fast AST",
        "min": 15,
        "max": 90,
        "step": 5,
        "defaultValue": 42,
        "unit": "Minutes/Day"
      },
      "competitorAnnualSaaSSeatCost": {
        "label": "Legacy Cloud SaaS AI Tool Cost per Developer (Cursor / Copilot)",
        "min": 180.0,
        "max": 480.0,
        "step": 20.0,
        "defaultValue": 240.0,
        "unit": "USD/User/Year"
      }
    },
    "mathematicalFormulas": {
      "annualRawTokens": "developerCount * dailyQueriesPerEngineer * annualWorkingDays * rawTokensPerQuery",
      "annualSlicedTokens": "annualRawTokens * (1 - astCompressionRatio)",
      "annualTokenTaxBaseline": "annualRawTokens * (blendedInputTokenPricePerMillion / 1000000)",
      "annualTokenTaxOmniKernel": "annualSlicedTokens * (blendedInputTokenPricePerMillion / 1000000)",
      "netAnnualTokenSavings": "annualTokenTaxBaseline - annualTokenTaxOmniKernel",
      "annualRecoveredHoursPerFte": "(dailyMinutesSavedPerEngineer / 60) * annualWorkingDays",
      "annualRecoveredDeveloperCapacity": "developerCount * annualRecoveredHoursPerFte * fullyBurdenedHourlyRateUsd",
      "capitalPaybackCalendarDays": "(omnikernelSoftwareCapex / (netAnnualTokenSavings / annualWorkingDays)) * (7 / 5)"
    },
